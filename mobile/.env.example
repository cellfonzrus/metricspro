# MetricsPro mobile — copy to `.env` and fill in. Only PUBLIC values belong here.
# The service-role Supabase key must NEVER be placed in this app.

# Supabase project URL (same project the web app uses)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase ANON / publishable key (public by design — RLS + backend token verification are the trust boundary)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend base URL (Railway in production, http://localhost:8000 in dev)
EXPO_PUBLIC_API_URL=https://your-api.railway.app

# EAS project id (from `eas init`); used by app.config.ts extra.eas.projectId
EAS_PROJECT_ID=
