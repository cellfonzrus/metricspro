# MetricsPro website — Apache configuration for shared hosting (Bluehost and equivalents).
# Upload this file alongside index.html. If your host ignores it, ask support to enable
# AllowOverride for the account; everything here is standard and safe to run on cPanel hosting.

# ── No directory listings ──────────────────────────────────────────────────────────────────────
# Without this, a folder holding no index file is served as a browsable listing of its contents.
# That is how this document root looked before the site landed in it, and it would still apply to
# /assets/ and /legal/, handing any visitor a complete file inventory. There is no case where a
# listing is wanted here.
Options -Indexes

# ── Force HTTPS ────────────────────────────────────────────────────────────────────────────────
# Turn this on only AFTER the SSL certificate is issued and https:// loads correctly, otherwise
# visitors are redirected to a page that cannot yet be served.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Canonical host: send the bare domain to www (or reverse the two lines to prefer the bare domain —
  # pick ONE and make sure it matches the <link rel="canonical"> in the HTML).
  RewriteCond %{HTTP_HOST} ^metricspro\.tech$ [NC]
  RewriteRule ^(.*)$ https://www.metricspro.tech/$1 [R=301,L]

  # Pretty URLs: /legal/terms serves /legal/terms.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^.]+)$ $1.html [NC,L]
</IfModule>

# ── Security headers ───────────────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  # HSTS — enable only once you are certain HTTPS works on every hostname you serve. A browser that
  # sees this header will REFUSE plain http for this domain for the stated period, and that cannot be
  # undone quickly. Start with a short max-age, raise it after a week of clean HTTPS.
  # Header always set Strict-Transport-Security "max-age=86400"
  #
  # Content-Security-Policy. This site loads: its own CSS/JS, the Google Fonts stylesheet and font
  # files, and one JSON request to the platform API. If you change apiBase in assets/config.js,
  # change the connect-src host here to match, or the price list will be blocked.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://metricspro-production.up.railway.app; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ── Caching ────────────────────────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  # HTML stays short so a legal-page edit goes live promptly.
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ── Compression ────────────────────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/json image/svg+xml
</IfModule>

ErrorDocument 404 /404.html

# Do not serve the repository's own working files if they ever get uploaded by mistake.
<FilesMatch "\.(md|sh|yml|yaml|json|lock)$">
  Require all denied
</FilesMatch>
