# ─────────────────────────────────────────────────────────────────────────────
# Autonomous-session environment variables.  See docs/AUTONOMY_SETUP.md for what
# each unlocks, how to scope it, and the read-only / write role SQL.
#
# Define these in the Claude Code ENVIRONMENT config — NOT in a committed file and
# NEVER pasted into chat.  This file only documents the NAMES.
# ─────────────────────────────────────────────────────────────────────────────

# ── Tier 1: read-only data (highest leverage) ───────────────────────────────
# Read-only Postgres role (SELECT only). See the claude_ro role SQL in the doc.
# NOTE: raw Postgres port may be blocked by the env network policy — if so, use
# the HTTPS route below instead.
DATABASE_URL=postgresql://claude_ro:CHANGE_ME@<PROJECT-REF>.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase over HTTPS (works through the proxy). Read key.
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME_READ_KEY

# ── Tier 1: backend API (act, not just read) ────────────────────────────────
API_BASE_URL=https://<your-backend>.up.railway.app
API_AUTH_TOKEN=CHANGE_ME_TENANT_ADMIN_TOKEN

# ── Direct-write option (full autonomy on schema + data) ─────────────────────
# Provide ONE of these to let the agent apply migrations/data fixes directly.
# See "The direct-write option" in the doc for the safeguards it follows.
DATABASE_WRITE_URL=postgresql://claude_rw:CHANGE_ME@<PROJECT-REF>.pooler.supabase.com:5432/postgres?sslmode=require
# or:
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY

# ── Tier 2: optional ─────────────────────────────────────────────────────────
# b2b ingestion mailbox (read-only) — only if the backend API above is NOT given.
INGEST_IMAP_HOST=
INGEST_IMAP_USER=
INGEST_IMAP_PASSWORD=

# Backend (Railway) deploy visibility.
RAILWAY_TOKEN=
