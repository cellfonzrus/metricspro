__pycache__/
*.pyc
_PENDING_MIGRATIONS_*.sql

# Secrets — never commit. The deploy habit here is `git add -A`, so an unignored
# backend/.env (SUPABASE_SERVICE_KEY, FIELD_ENCRYPTION_KEY, portal creds) would be
# swept straight into a public commit.
.env
.env.*
!.env.example
*.env
*creds*
.metricspro_token
*.pem
*.key
.worktrees/
.claude/worktrees/
# Per-developer Claude Code overrides (permissions, env). The shared, team-wide
# config belongs in .claude/settings.json; this one is personal and must not be
# swept into a commit by the `git add -A` deploy habit noted above.
.claude/settings.local.json
