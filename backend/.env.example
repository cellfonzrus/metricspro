SUPABASE_URL=https://etxdalernqqtwjcrtcuj.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here
APP_ENV=development

# ── Security-critical secrets (Security Controls Spec §2) ─────────────────────────────────────────
# Field-level encryption key for SSN / bank fields (app/core/crypto.py). WITHOUT this the app runs but
# those fields are stored in PLAINTEXT (fails open) — set it in every real deployment. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate multiple keys to rotate (first = encrypt, all = decrypt).
FIELD_ENCRYPTION_KEY=
# Shared secret for JWT-less scheduler/cron endpoints (/notify/run-due, /core/audit/prune/run-due,
# /core/tenants/sync, …). Long, random; compared constant-time. Empty ⇒ those endpoints refuse (403).
NOTIFY_RUN_SECRET=

# ── Enforcement switches (all documented in docs/SECURITY_CONTROLS_SPEC.md) ───────────────────────
# Tenant isolation: derive org_id from the verified token. Default OFF — enable deliberately once the
# isolation test passes. See app/core/tenant_middleware.py.
MULTI_TENANT_ENFORCE=0
# Server-side session controls (idle + absolute lifetime). Default OFF — turning it on can end active
# sessions, so enable deliberately. Windows below apply only when enforce is on.
SESSION_ENFORCE=0
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Inbound rate limiting (per-IP). Default ON with generous limits; RATE_LIMIT_ENFORCE=0 disables.
RATE_LIMIT_ENFORCE=1
RATE_LIMIT_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=20
# HSTS max-age in seconds (0 disables the header, e.g. a plain-HTTP staging box).
HSTS_MAX_AGE=31536000
